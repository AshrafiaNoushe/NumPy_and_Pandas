    "import matplotlib.pyplot as plt\n",
    "\n",
    "subjects = [\"C\", \"C++\", \"Python\", \"DBMS\"]\n",
    "marks = [80, 75, 90, 85]\n",
    "\n",
    "plt.pie(marks, labels=subjects)\n",
    "plt.title(\"Subject Marks\")\n",
    "plt.savefig('pie_chart_01.png')\n",
    "plt.show()"
